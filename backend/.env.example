PROJECT_NAME="FloatChat API"
VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
LOG_LEVEL="INFO"

# Data Provider Configuration (Argo / GDAC)
DATA_PROVIDER="argo"
ARGO_BASE_URL="https://erddap.ifremer.fr/erddap/tabledap/ArgoFloats.json"
ARGO_REQUEST_TIMEOUT=15.0
ARGO_MAX_RECORDS=500

# MongoDB Atlas Application Database Settings
MONGODB_URI=mongodb+srv://floatchat_app:<PASSWORD>@<CLUSTER_HOST>/?appName=FloatChatCluster
MONGODB_DATABASE=floatchat

# Native JWT Authentication Settings
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI / LLM Configuration Settings
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.0
AI_TIMEOUT_SECONDS=15.0
AI_FALLBACK_TO_DETERMINISTIC=true
