# ==============================================================================
# FloatChat Environment Configuration
# ==============================================================================
# Copy this file to .env and configure the parameters for your local environment.
# DO NOT commit real API keys, passwords, or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM Intelligence Layer Configuration
# ------------------------------------------------------------------------------
# LLM Provider: 'mock' (offline deterministic development), 'gemini', 'openai'
LLM_PROVIDER=mock
# Model identifier
LLM_MODEL=gemini-2.5-flash
# Sampling temperature (0.0 for deterministic factual parsing)
LLM_TEMPERATURE=0.0
# Google Gemini API Key (Required only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Oceanographic Data Layer Configuration
# ------------------------------------------------------------------------------
# ARGO Data Provider: 'sample' (in-memory offline dataset), 'netcdf', 'parquet', 'remote'
ARGO_DATA_PROVIDER=sample
# Local file or directory path for NetCDF (*.nc) or Parquet (*.parquet) datasets
ARGO_DATA_PATH=
# Base endpoint for remote ARGO API (Argovis v3 / ERDDAP)
ARGOVIS_API_URL=https://argovis-api.colorado.edu/data/argo
# Remote Argovis API Key (Optional, increases public rate limits)
ARGOVIS_API_KEY=

# ------------------------------------------------------------------------------
# 3. Backend & FastAPI Server Configuration
# ------------------------------------------------------------------------------
PROJECT_NAME=FloatChat
API_V1_STR=/api/v1
# Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 4. Database (MongoDB) Configuration
# ------------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=floatchat_db

# ------------------------------------------------------------------------------
# 5. Security & Authentication Configuration
# ------------------------------------------------------------------------------
# Secret key for signing JWT tokens (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=generate_a_secure_random_64_char_hex_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 6. Frontend Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
